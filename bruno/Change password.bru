meta {
  name: Change password
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/patients/anna.nowak@example.com/password
  body: json
  auth: inherit
}

body:json {
  {
    "password": "Nowe#Haslo2026"
  }
}

assert {
  res.status: eq 200
}

settings {
