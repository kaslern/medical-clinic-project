meta {
  name: Dodaj recenzje
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/posts
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Lalka",
    "body": "Recenzja czytelnika"
  }
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
