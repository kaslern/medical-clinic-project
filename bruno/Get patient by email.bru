meta {
  name: Get patient by email
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/patients?email=anna.nowak@example.com
  body: none
  auth: inherit
}

params:query {
  email: anna.nowak@example.com
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
